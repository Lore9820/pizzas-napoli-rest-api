meta {
  name: Create order
  type: http
  seq: 1
}

post {
  url: http://localhost:3000/orders
  body: json
  auth: none
}

body:json {
  {
    "customer_id": "2",
    "amount": 7,
    "orderlines": [
      {
        "pizza_id": 1,
        "unitPrice": 7,
        "quantity": 1,
        "amount": 7
      }
    ]
  }
}

assert {
  res.status: eq 201
  res.header.location: isDefined
  res.body.order: isDefined
}
